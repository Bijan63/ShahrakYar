generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// USER & PERSON
// ======================================================

model User {
  id String @id @default(uuid())

  fullName String

  email String @unique

  password String

  role UserRole @default(USER)

  status UserStatus @default(ACTIVE)

  personId String? @unique

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  resident Resident?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Person {
  id String @id @default(uuid())

  firstName String

  lastName String

  nationalId String? @unique

  mobile String

  email String?

  status PersonStatus @default(ACTIVE)

  gender Gender?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User?

  ownerships Ownership[]

  residencies Residency[]

  candidates Candidate[]

  votes Vote[]

  auditLogs AuditLog[]

  resident Resident?
}

// ======================================================
// COMPLEX
// ======================================================

model Complex {
  id String @id @default(uuid())

  name String

  address String?

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  buildings Building[]

  properties Property[]
}

// ======================================================
// BUILDING
// ======================================================

model Building {
  id String @id @default(uuid())

  name String

  address String?

  description String?

  complexId String

  complex Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)

  units Unit[]

  residents Resident[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([complexId, name])
  @@index([complexId])
}

// ======================================================
// PROPERTY
// ======================================================

model Property {
  id String @id @default(uuid())

  complexId String

  complex Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)

  code String @unique

  registryNumber String?

  propertyType PropertyType

  status PropertyStatus @default(VACANT)

  landArea Float?

  builtArea Float?

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  units Unit[]

  ownerships Ownership[]

  residencies Residency[]

  addresses PropertyAddress[]

  @@index([complexId])
  @@index([propertyType])
  @@index([status])
}

// ======================================================
// UNIT
// ======================================================

model Unit {
  id String @id @default(uuid())

  unitNumber String

  floor Int?

  area Float?

  code String? @unique

  buildingId String?

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  propertyId String?

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  residents Resident[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([buildingId])
  @@index([propertyId])
}

// ======================================================
// PROPERTY ADDRESS
// ======================================================

model PropertyAddress {
  id String @id @default(uuid())

  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  mainStreet String?

  subStreet String?

  alley String?

  number String?

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// ======================================================
// OWNERSHIP
// ======================================================

model Ownership {
  id String @id @default(uuid())

  propertyId String

  personId String

  percentage Float @default(100)

  startDate DateTime @default(now())

  endDate DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([propertyId, personId, startDate])
  @@index([propertyId])
  @@index([personId])
}

// ======================================================
// RESIDENCY
// ======================================================

model Residency {
  id String @id @default(uuid())

  propertyId String

  personId String

  type ResidencyType

  startDate DateTime @default(now())

  endDate DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([propertyId, personId, startDate])
  @@index([propertyId])
  @@index([personId])
}

// ======================================================
// RESIDENT
// ======================================================

model Resident {
  id String @id @default(uuid())

  fullName String

  mobile String

  residentType ResidentType

  userId String @unique

  unitId String

  buildingId String?

  personId String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  votes Vote[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([buildingId])
}

// ======================================================
// ELECTION
// ======================================================

model Election {
  id String @id @default(uuid())

  title String

  description String?

  startDate DateTime

  endDate DateTime

  status ElectionStatus @default(DRAFT)

  candidates Candidate[]

  votes Vote[]

  auditLogs AuditLog[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
}

// ======================================================
// CANDIDATE
// ======================================================

model Candidate {
  id String @id @default(uuid())

  electionId String

  personId String

  biography String?

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  votes Vote[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([electionId, personId])
  @@index([personId])
}

// ======================================================
// VOTE
// ======================================================

model Vote {
  id String @id @default(uuid())

  electionId String

  voterId String

  candidateId String

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  voter Person @relation(fields: [voterId], references: [id], onDelete: Cascade)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  resident   Resident? @relation(fields: [residentId], references: [id])
  residentId String?

  @@unique([electionId, voterId])
  @@index([candidateId])
  @@index([voterId])
}

// ======================================================
// AUDIT LOG
// ======================================================

model AuditLog {
  id String @id @default(uuid())

  action String

  entity String

  entityId String

  userId String?

  personId String?

  electionId String?

  description String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  election Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([personId])
  @@index([electionId])
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PropertyType {
  LAND
  VILLA
  APARTMENT
  COMMERCIAL
}

enum PropertyStatus {
  VACANT
  BUILT
  UNDER_CONSTRUCTION
  INACTIVE
}

enum ResidencyType {
  OWNER
  TENANT
  FAMILY
}

enum ResidentType {
  OWNER
  TENANT
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}
